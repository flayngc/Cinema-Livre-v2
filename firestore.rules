rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() {
      return verified() && request.auth.token.email in [
        'clansagostinho@gmail.com',
        'muqueiojose@gmail.com'
      ];
    }

    // Catálogo: todos leem, só administradores gravam
    match /titles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Perfil: cada pessoa lê e grava só o seu
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Votação
    match /wishes/{wid} {
      allow read: if true;

      // Máximo de 3 sugestões por pessoa: o id tem de ser <uid>_1, <uid>_2 ou <uid>_3
      allow create: if verified()
        && wid.matches(request.auth.uid + '_[123]')
        && request.resource.data.keys().hasOnly(['id', 't', 'by', 'votes'])
        && request.resource.data.t is string
        && request.resource.data.t.size() >= 2
        && request.resource.data.t.size() <= 80
        && request.resource.data.by == request.auth.uid
        && request.resource.data.votes == [request.auth.uid];

      // Só dá para acrescentar OU tirar o próprio voto, nunca mexer no de outros
      allow update: if verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && (
          (request.resource.data.votes.toSet().difference(resource.data.votes.toSet()) == [request.auth.uid].toSet()
            && resource.data.votes.toSet().difference(request.resource.data.votes.toSet()).size() == 0)
          ||
          (resource.data.votes.toSet().difference(request.resource.data.votes.toSet()) == [request.auth.uid].toSet()
            && request.resource.data.votes.toSet().difference(resource.data.votes.toSet()).size() == 0)
        );

      allow delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
    }

    // Pedidos de remoção: qualquer pessoa envia, só administradores leem
    match /takedowns/{tid} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'title', 'reason', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 1500
        && request.resource.data.at is number;
      allow read, delete: if isAdmin();
    }

    // Backups automáticos do catálogo
    match /backups/{day} {
      allow read, write: if isAdmin();
    }
  }
}
